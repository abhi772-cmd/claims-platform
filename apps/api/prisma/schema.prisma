// Walking-skeleton schema. Tenant + auth surface only.
// Business modules (case, claim, claim_event, integration_message, etc.)
// land in subsequent sprints — see docs/03-data-model.md for the full plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MIGRATOR")
}

enum TenantLifecycleState {
  CONTRACTED
  PROVISIONING
  IN_SETUP
  PILOT
  LIVE
  SUSPENDED
  CHURNED
}

// Profile classification fields. Captured in Stage 1 of the onboarding
// flow (docs/15) by ops on tenant provisioning.
enum HospitalType {
  private
  trust
  government
  psu
}

// Self-declared volume band, used for capacity planning + tiering.
// Bucket labels match docs/15 stage 1 wording.
enum ExpectedMonthlyClaimsBand {
  lt_100      // <100
  band_100_500    // 100-500
  band_500_2000   // 500-2000
  gt_2000     // 2000+
}

// Slice ON-2 — Stage-3 KYC document types. The first six are the
// KYC artefacts NHA + IRDAI evidence; dpa_signed + msa_signed are
// the platform-side legal agreements (slice ON-3 wires the signed-PDF
// re-upload flow).
enum KycDocumentType {
  hospital_registration
  rohini_registration
  gst_certificate
  pan
  signatory_id
  cancelled_cheque
  dpa_signed
  msa_signed
}

// Lifecycle:
//   uploading       — init created the row; client is PUT-ing bytes
//   pending_review  — finalize observed the bytes; awaiting ops
//   approved        — ops accepted (slice ON-3)
//   rejected        — ops rejected outright (slice ON-3)
//   resubmission_requested — ops asked the tenant to redo (slice ON-3)
enum KycDocumentStatus {
  uploading
  pending_review
  approved
  rejected
  resubmission_requested
}

enum UserStatus {
  invited
  active
  suspended
  deactivated
}

// Encrypted PII for a single patient. patientName lives in Case as
// plaintext (it's already on every screen + in audit logs); the truly
// sensitive identifiers (Aadhaar, ABHA ID, policy number, mobile,
// email) are stored as base64(IV || ciphertext || authTag) here under
// AES-256-GCM with a per-tenant data encryption key wrapped by the
// platform KMS root key.
//
// One Patient row per case (FK on patientId from Case). Demographic
// fields go here too so PII is in one place; the Case keeps display
// fields (patientName, hospitalMrn) for the list view without needing
// to decrypt every row.
//
// All ciphertext columns are nullable because Sprint 2 cases were
// created before this slice landed — they have no Patient row.
model Patient {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  // Plaintext display fields. patientName here mirrors Case.patientName
  // (kept in sync on update) so future joins don't need decryption for
  // the common read path.
  fullName      String
  dateOfBirth   DateTime? @db.Date
  gender        String?  // 'male' | 'female' | 'other' | 'prefer_not_to_say'
  // Encrypted PII. Each column is a base64-encoded
  // [iv (12 bytes) || ciphertext (n bytes) || authTag (16 bytes)] blob.
  // The DEK id (the KMS-wrapped key version that produced this blob)
  // is stored alongside in <field>KeyVersion so we can rotate keys
  // without re-encrypting everything atomically.
  aadhaarCipher       String?
  aadhaarKeyVersion   String?
  abhaIdCipher        String?
  abhaIdKeyVersion    String?
  policyNumberCipher      String?
  policyNumberKeyVersion  String?
  mobileCipher        String?
  mobileKeyVersion    String?
  emailCipher         String?
  emailKeyVersion     String?
  // Hashed (sha256) lookup keys so we can search by Aadhaar / mobile
  // without decrypting every row. The hash is computed over the raw
  // value with no salt — the lookup is exact-match only and a salt
  // would prevent equality lookups.
  aadhaarHash         String?  @db.Char(64)
  mobileHash          String?  @db.Char(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cases Case[]

  @@index([tenantId])
  @@index([tenantId, aadhaarHash])
  @@index([tenantId, mobileHash])
  @@map("patient")
}

// One row per insurance + treatment instance. A case is the container;
// each case has 1..N claims (e.g. NHCX cashless + later reimbursement).
//
// patientName + hospitalMrn live on Case for fast list-view rendering
// without decryption. Sensitive identifiers (Aadhaar / ABHA / policy
// number / contact info) live on the linked Patient row in encrypted
// form. patientId is nullable for the legacy cases that pre-date
// Slice R; new cases always create a Patient row.
model Case {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  patientId       String?   @db.Uuid
  patientName     String
  hospitalMrn     String
  admissionDate   DateTime  @db.Date
  admissionType   String    // 'planned' | 'emergency' | 'day_care'
  primaryRail     String    // 'nhcx' | 'pmjay' | 'self_pay'
  caseStatus      String    @default("open") // 'open' | 'closed' | 'abandoned'
  treatingDoctorId String?  @db.Uuid
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  closedAt        DateTime?

  claims                 Claim[]
  patient                Patient?                @relation(fields: [patientId], references: [id], onDelete: SetNull)
  biometricVerifications BiometricVerification[]

  @@index([tenantId, caseStatus])
  @@index([tenantId, hospitalMrn])
  @@index([patientId])
  @@map("case")
}

// Materialised state of the claim. The source of truth is ClaimEvent —
// this row is the rolled-up view for fast reads. Every write must go
// through ClaimService.transition() so the event log + materialised
// state stay in lockstep.
model Claim {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  caseId          String    @db.Uuid
  rail            String    // 'nhcx' | 'pmjay' | 'self_pay'
  status          String    // ClaimStatus enum (35 values, see contracts)
  preauthAmount   Int?
  claimAmount     Int?
  approvedAmount  Int?
  paidAmount      Int?
  preauthRefNum   String?
  claimRefNum     String?
  payerRefNum     String?
  // Captured at eligibility time. Drives the coverage actor on every
  // subsequent FHIR R4 outbound (preauth, discharge, claim, communication)
  // so we don't re-pass the payer code on every request.
  payerCode       String?
  assignedToUserId String?  @db.Uuid
  initiatedAt     DateTime  @default(now())
  submittedAt     DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  closedAt        DateTime?

  case   Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  events ClaimEvent[]

  @@index([tenantId, status])
  @@index([tenantId, assignedToUserId, status])
  @@index([caseId])
  @@map("claim")
}

// Append-only via RLS. Application code that tries to UPDATE/DELETE
// these rows is silently rejected. resultingStatus captures what the
// claim's status BECAME after this event was applied, so a replay can
// reconstruct without re-running the transition table.
model ClaimEvent {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  claimId         String   @db.Uuid
  eventType       String
  resultingStatus String
  occurredAt      DateTime
  recordedAt      DateTime @default(now())
  recordedById    String?  @db.Uuid
  payload         Json     @default("{}")
  correlationId   String?
  // Chain pointer to the previous event for this claim. NULL for
  // case.created. Used by the reconstruction service for ordered
  // replay without relying on createdAt-tiebreaks.
  prevEventId     String?  @db.Uuid

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, occurredAt])
  @@index([tenantId, eventType])
  @@map("claim_event")
}

model Tenant {
  id              String               @id @default(uuid()) @db.Uuid
  slug            String               @unique
  displayName     String
  lifecycleState  TenantLifecycleState @default(IN_SETUP)
  logoUrl         String?
  // Tenant-level IP allowlist. Stored as a JSON array of CIDR strings
  // ("203.0.113.0/24", "2001:db8::/32") or single IPs. Empty array (the
  // default) means no restriction. platform_admin bypasses regardless.
  ipAllowlist     Json                 @default("[]")
  // Per-tenant communication channel configuration. Empty object
  // means "use the platform-default env config" (SMTP_HOST,
  // SMTP_PORT, SMTP_FROM, the SMS console-stub). Operators override
  // per-tenant via /admin/tenant/comms-config. Secrets (smtp.password,
  // sms.apiKey) live on the row gated by RLS; the read endpoint
  // returns a redacted summary, never the raw values. KMS-wrapping
  // those fields lands in Sprint 5.
  commsConfig     Json                 @default("{}")
  // PMJAY rail toggle. 'on' enables the PMJAY-via-NHCX flow which
  // mandates ABDM biometric / face / iris verification before
  // preauth submit and before claim submit (BG gate). 'off' is the
  // default — non-PMJAY tenants don't pay the integration tax.
  pmjayMode       String               @default("off")
  // Slice CG — DPDP §6 hard-enforcement flag. When true,
  // FhirContextService.build throws ConsentRequiredError if no
  // active grant exists for the (patient, consentType) tuple at
  // the start of any preauth / claim / discharge flow. Default
  // false for back-compat: existing tenants run under soft
  // binding (CB) until ops verifies their "unbound access in
  // 24h" count is zero on the BU dashboard, then flips this on.
  // Per-tenant flip means the rollout doesn't break tenants
  // that haven't backfilled grants.
  requireConsent  Boolean              @default(false)
  // Stage-1 onboarding profile (docs/15). Captured by ops on tenant
  // provisioning. All nullable — pre-existing tenants pre-date the
  // slice and fill these in via the wizard when next touched. The
  // application enforces "required for NHCX cutover" higher up in
  // the readiness check, not at the column level.
  legalName                 String?
  rohiniId                  String?
  hospitalType              HospitalType?
  bedCount                  Int?
  hmisVendor                String?
  expectedMonthlyClaimsBand ExpectedMonthlyClaimsBand?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  users            User[]
  roles            Role[]
  onboardingSteps  OnboardingStep[]
  biometricVerifications BiometricVerification[]
  kycDocuments     KycDocument[]
  nhcxConfig       TenantNhcxConfig?

  @@map("tenant")
}

// Slice ON-4 — NHCX participant onboarding state. One row per tenant,
// written by ops via /admin/tenants/:id/nhcx/register-participant.
// `participantCode` is null until the NHA call succeeds; `lastError`
// captures the most recent failure for the ops UI.
model TenantNhcxConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @unique @db.Uuid
  hfrFacilityId       String
  participantCode     String?
  role                String   @default("provider")
  callbackUrl         String
  sandboxMode         Boolean  @default(true)
  registeredAt        DateTime?
  registeredByUserId  String?  @db.Uuid
  lastError           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_nhcx_config")
}

// Slice ON-2 — KYC document upload row. Two-stage lifecycle: init
// allocates the row in `uploading`, client PUTs to the presigned URL,
// finalize flips to `pending_review`. Bytes never flow through the
// API server. Review status fields populate in slice ON-3.
model KycDocument {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  documentType         KycDocumentType
  status               KycDocumentStatus @default(uploading)
  storageBucket        String?
  storageKey           String?
  originalFilename     String
  contentType          String
  declaredSizeBytes    Int
  actualSizeBytes      Int?
  sha256               String?  @db.Char(64)
  etag                 String?
  uploadedByUserId     String   @db.Uuid
  uploadedAt           DateTime @default(now())
  finalizedAt          DateTime?
  reviewedByUserId     String?  @db.Uuid
  reviewedAt           DateTime?
  reviewNotes          String?
  rejectionReasonCode  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentType])
  @@index([tenantId, status])
  @@index([status, uploadedAt])
  @@map("kyc_document")
}

// Slice BG — PMJAY biometric verification ledger. Written when a
// successful ABDM biometric / face / iris verification completes for
// a case. The PreauthService and ClaimSubmitService consult this
// table to gate submission when the tenant is in pmjayMode='on'.
//
// We deliberately do NOT store the ABHA `authToken` or
// `refreshToken` returned by ABDM in this slice — BG only needs to
// know "did a verification happen for (case, process) within the
// TTL window?" The token is needed when the FHIR Bundle is built
// (a follow-up slice will add encrypted token storage); for now the
// row's mere existence is the gate.
//
// `process` mirrors the ABDM header: 'Preauth' verifications gate
// preauth/submit, 'Discharge' verifications gate claim/submit.
// `loginIdHash` is sha256(loginId) so the audit trail can correlate
// a verification to a beneficiary without storing the raw ABHA /
// Aadhaar number.
model BiometricVerification {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  caseId        String   @db.Uuid
  // Either 'Preauth' or 'Discharge'. The gate checks for a
  // non-expired row matching the (caseId, process) pair.
  process       String
  // 'FINGERPRINT' | 'IRIS' | 'FACE_AUTH' — matches BiometricAuthMode
  // on the adapter side.
  authMode      String
  // 'abha-number' | 'mobile' | 'aadhaar'
  loginHint     String
  // sha256(loginId) — stored as hex. The raw loginId is PII (ABHA
  // number / mobile / Aadhaar) and never persisted.
  loginIdHash   String
  // ABDM-issued txnId from the adapter init/verify dance. Useful
  // for cross-referencing with integration_message logs and ABDM
  // audit logs during incident review. Not used by the gate.
  abdmTxnId     String
  verifiedAt    DateTime @default(now())
  // verifiedAt + BIOMETRIC_VERIFICATION_TTL_MINUTES (env-driven,
  // defaults to 60). The gate refuses verifications older than
  // this — operators get bounced back to re-capture biometric.
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([tenantId, caseId, process, expiresAt])
  @@map("biometric_verification")
}

// One row per (tenant, step). Created lazily on first complete; we don't
// pre-seed pending rows because the canonical step list lives in
// contracts and we'd otherwise double-bookkeep. The readiness check
// joins onto this table left-outer to find the latest status per step.
model OnboardingStep {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  stepKey      String
  status       String   // 'pending' | 'in_progress' | 'completed' | 'skipped'
  evidence     Json     @default("{}")
  completedAt  DateTime?
  completedBy  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stepKey])
  @@index([tenantId])
  @@map("onboarding_step")
}

// Roles can be tenant-scoped (most cases) or platform-wide (platform_admin
// has tenantId = NULL). The runtime queries with the platform_admin GUC
// when handling pre-tenant flows like login.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  name        String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, name])
  @@map("role")
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String     @db.Uuid
  email                String     @unique
  mobile               String?
  // Empty string for invited-but-not-accepted users; set during accept-invite.
  // argon2 verify() fails on a non-argon2 string, so login refuses these.
  passwordHash         String
  status               UserStatus @default(active)
  firstName            String
  lastName             String
  designation          String?
  mfaEnabled           Boolean    @default(false)
  mfaSecret            String?
  mustChangePassword   Boolean    @default(false)
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  lastLoginUserAgent   String?
  // Invitation flow (Slice B). Token is hashed on storage; raw token only
  // exists in the email/SMS the invitee receives.
  inviteTokenHash      String?    @unique
  inviteTokenExpiresAt DateTime?
  inviteAcceptedAt     DateTime?
  invitedById          String?    @db.Uuid
  // Password lifecycle. lastPasswordChangeAt is null for users who have
  // never accepted (passwordHash = '').
  lastPasswordChangeAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles         UserRole[]
  sessions          Session[]
  inviteResends     InviteResend[]
  passwordHistory   PasswordHistory[]
  passwordResets    PasswordResetToken[]
  mfaEnrollment     MfaEnrollment?
  backupCodes       BackupCode[]
  mfaChallenges     MfaChallenge[]
  trustedDevices    TrustedDevice[]
  doctorTokens      DoctorToken[]        @relation("DoctorTokensByDoctor")
  doctorTokensIssued DoctorToken[]       @relation("DoctorTokensByIssuer")

  @@index([tenantId, status])
  @@index([inviteTokenExpiresAt])
  @@map("user")
}

// Tracks invite resends for rate limiting (3 per 24h per user) and audit.
model InviteResend {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  resentBy  String   @db.Uuid
  resentAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, resentAt])
  @@map("invite_resend")
}

// Persistent outbox for notifications (email + SMS). Workers poll status='queued'
// and dispatch via the Email/Sms adapters. Status transitions on success/failure.
// Kept tenant-scoped so RLS isolation applies.
model NotificationOutbox {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  channel      String   // 'email' | 'sms' | 'in_app'
  templateKey  String
  recipient    String   // email address or phone number
  payload      Json
  status       String   @default("queued") // 'queued' | 'sent' | 'failed'
  attempts     Int      @default(0)
  lastError    String?
  scheduledAt  DateTime @default(now())
  sentAt       DateTime?

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, recipient])
  @@map("notification_outbox")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_role")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  // Last refresh hit — used by the session list page to show "active 5 min
  // ago" and by future analytics. Updated on every refresh + tokens use.
  lastSeenAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("session")
}

// Long-lived "remember this device" credential. Issued on /auth/mfa/verify
// when the user opts in via trustDevice=true; stores only sha256(token)
// at rest. Validity = 30 days. The user can list/revoke these from
// /me/trusted-devices.
model TrustedDevice {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  // Coarse fingerprint to bind the cookie to the device that requested it.
  // We use the User-Agent string sha256 — not bullet-proof, but stops a
  // stolen cookie from working from a wildly different browser.
  uaFingerprint String?
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("trusted_device")
}

// Audit pointer for refresh-token reuse detection. When we rotate a refresh
// token we record the previous hash here. If it ever shows up again, it's
// reuse — we kill all of that user's sessions (D-001 behaviour from
// docs/14 §refresh-token-rotation).
model SessionTokenHistory {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  rotatedAt        DateTime @default(now())

  @@index([userId])
  @@map("session_token_history")
}

// Append-only password history. We block reuse of the last N hashes
// (default 5) — the policy module reads the most recent rows and runs
// argon2.verify against each. Old hashes are retained beyond the depth
// for audit / forensics; only the top-N are checked for reuse.
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  changedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, changedAt])
  @@map("password_history")
}

// One row per reset request. Tokens are hashed on storage, raw token only
// exists in the email. The row is marked usedAt on successful reset; we
// also track requestedIp and a daily rate-limit count via a query on
// occurredAt rather than a separate counter.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  requestedAt DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  requestedUa String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, requestedAt])
  @@index([expiresAt])
  @@map("password_reset_token")
}

// Pending MFA enrollment OR confirmed enrollment. One row per user.
// `confirmedAt` flips from null to a timestamp on /auth/me/mfa/confirm.
// We keep the pending row separate from the confirmed state so that a
// half-finished setup never leaves the user's confirmed login broken.
// The secret is base32 (otpauth standard) and is rotated on every new
// setup attempt.
model MfaEnrollment {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  userId              String    @unique @db.Uuid
  secret              String
  confirmedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Last verified TOTP step — used to prevent code replay within the same
  // 30-second window. Set on each successful verify; if a verify presents
  // a step <= this value, it's a replay and we reject.
  lastUsedStep        BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("mfa_enrollment")
}

// Backup codes are issued in batches of 10 on confirm + on regenerate.
// Stored hashed (sha256). usedAt is append-only via RLS — the row is
// either unused (NULL) or carries the timestamp of the single use that
// burned it.
model BackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("backup_code")
}

// Server-side staging row for the two-step login. When MFA is required,
// /auth/login does the password check, opens a challenge, and returns
// the challengeId to the client. The client then calls /auth/mfa/verify
// with challengeId + TOTP/backup code. The challenge expires in 5 min.
model MfaChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  challengeId String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("mfa_challenge")
}

// Short-lived (10-min) opaque token used to authorise a doctor's clinical
// signature on a pre-auth without forcing them to log in. Sent via the
// doctor's email/SMS by the insurance desk. Hashed (sha256) at rest;
// raw token only exists in the email/SMS link.
//
// usedAt flips on a successful sign call (single-use). signedHprId +
// signedFullName + signedAt + signatureNote capture the proof — pre-auth
// records reference these for evidentiary purposes once Sprint 2's
// claim_id linkage lands.
model DoctorToken {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  doctorUserId  String    @db.Uuid
  createdById   String    @db.Uuid
  scope         String    // 'preauth_clinical_sign' (one of DoctorTokenScope)
  caseRef       String
  patientName   String
  tokenHash     String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  usedAt        DateTime?
  signedHprId   String?
  signedFullName String?
  signatureNote String?
  ipAddress     String?
  userAgent     String?

  doctor    User @relation("DoctorTokensByDoctor", fields: [doctorUserId], references: [id], onDelete: Cascade)
  createdBy User @relation("DoctorTokensByIssuer", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, doctorUserId])
  @@index([expiresAt])
  @@map("doctor_token")
}

// One row per claim. Created on claim.approved / claim.partially_approved
// (the SettlementService.expectPayment path). Updates flip:
//   * receivedAmount + receivedAt + eobDocumentId on bank receipt
//   * deductionAmount + deductions on reconciliation
//   * shortPaymentReasons on short-paid path
//   * reconciliationStatus through auto_matched / manual_match_pending /
//     short_paid / discrepancy
//   * closedAt on terminal close (claim.closed event)
model Settlement {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  claimId              String   @unique @db.Uuid
  paymentMode          String
  expectedAmount       Int
  receivedAmount       Int?
  deductionAmount      Int?
  deductions           Json     @default("[]")
  shortPaymentReasons  Json     @default("[]")
  receivedAt           DateTime?
  eobDocumentId        String?  @db.Uuid
  bankTxnId            String?
  reconciliationStatus String   @default("manual_match_pending")
  closedAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId, claimId])
  @@index([tenantId, reconciliationStatus])
  @@map("settlement")
}

// File metadata only — binaries live in OVH Object Storage. v1 stores
// references with a synthetic storage key; the real upload pipeline
// lands in Slice P alongside the NHCX adapter.
// File metadata + lifecycle. Binaries live in OVH Object Storage. The
// row goes through three states:
//   uploadStatus='pending'   row created on upload-init; client has the
//                            presigned PUT URL but hasn't completed the
//                            transfer yet.
//   uploadStatus='completed' client called finalize → server HEAD'd the
//                            object → etag + sizeBytes confirmed on the
//                            row. Discharge / claim-submit flows only
//                            count rows in this state.
//   uploadStatus='failed'    finalize failed (object missing, size
//                            mismatch, etc.). Stays in this state until
//                            cleanup or retry.
//
// The legacy upload-stub flow short-circuits straight to 'completed'
// with synthesised storageKey + sizeBytes — it's still used by tests
// and the dev environment when STORAGE_MODE=stub.
model Document {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  claimId           String   @db.Uuid
  documentType      String   // see DocumentType enum in contracts
  storageBucket     String
  storageKey        String
  etag              String?
  contentType       String
  // sizeBytes is the CLIENT-DECLARED size on init; finalize replaces it
  // with the server-observed size from S3 HEAD. Both are nominally the
  // same — they diverge only when the upload is corrupted or the client
  // lied, and finalize rejects in those cases.
  sizeBytes         Int
  originalFilename  String
  uploadStatus      String   @default("completed") // 'pending' | 'completed' | 'failed'
  // sha256 hex-encoded; required at finalize time on real-mode uploads
  // so the virus-scan + content-integrity check have a stable handle.
  // Stub-mode + legacy upload-stub rows leave it null (no real bytes
  // to hash).
  contentSha256     String?
  // Virus-scan lifecycle. Independent from uploadStatus so the row can
  // be 'completed' (finalize succeeded, etag captured) but still
  // 'pending' on scan. Discharge / claim-submit consumers gate on
  // scanStatus='clean'.
  //   pending  — finalize succeeded but scan hasn't run yet
  //   clean    — scanned, no signature match
  //   infected — scanner reported a hit; the row is unusable
  //   skipped  — scan disabled for this deployment (stub mode)
  //   failed   — scan probe error after retries (operator review)
  scanStatus        String   @default("skipped")
  scanEngine        String?
  scanSignature     String?
  scannedAt         DateTime?
  // Last finalize / scan failure reason — surfaces back to the UI on retry.
  uploadError       String?
  finalizedAt       DateTime?
  uploadedAt        DateTime @default(now())
  uploadedById      String?  @db.Uuid

  @@index([tenantId, claimId])
  @@index([claimId, documentType])
  @@index([tenantId, uploadStatus])
  @@index([tenantId, scanStatus])
  @@index([uploadStatus, finalizedAt])
  @@map("document")
}

// Editable pre-auth draft. One row per Claim (unique on claimId).
// Updated as the executive types; on submit the draft is frozen
// (submittedSnapshot captures the values at submit time) and the
// claim transitions to PREAUTH_QUEUED.
model PreauthDraft {
  id                        String    @id @default(uuid()) @db.Uuid
  tenantId                  String    @db.Uuid
  claimId                   String    @unique @db.Uuid
  diagnosisIcdCode          String?
  diagnosisDescription      String?
  plannedProcedure          String?
  procedureCode             String?
  estimatedLengthOfStayDays Int?
  requestedAmount           Int?
  clinicalJustification     String?
  submittedAt               DateTime?
  submittedSnapshot         Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([tenantId, claimId])
  @@map("preauth_draft")
}

// One row per query raised by the payer on a pre-auth. respondedAt
// flips on response and the response text is stored alongside.
model PreauthQuery {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  claimId       String    @db.Uuid
  queryText     String
  raisedAt      DateTime  @default(now())
  respondedAt   DateTime?
  responseText  String?
  correlationId String?

  @@index([tenantId, claimId, raisedAt])
  @@map("preauth_query")
}

// Slice AH — appeal lifecycle.
// Created when an operator starts an appeal against a rejected
// preauth, rejected claim, or short-paid settlement (the three
// states that have an appeal.started outbound transition).
//
//   started  → the operator captured the rejection reason and the
//              ground we're appealing on; claim moves to
//              APPEAL_INITIATED.
//   submitted → evidence is finalised + sent to the payer (in this
//               slice the "send" is a stub — real outbound to the
//               payer's appeals desk lands in a Sprint 5 slice). The
//               claim moves to APPEAL_SUBMITTED.
//   resolved  → operator records the payer's decision (approved /
//               partially_approved / rejected). When the resolution
//               has an approved amount, settlement.expectPayment
//               drives payment.expected (APPEAL_RESOLVED → PAYMENT_
//               PENDING). When fully rejected, the operator's next
//               step is claim.written_off (APPEAL_RESOLVED →
//               WRITTEN_OFF).
//
// Indexed by (tenantId, claimId) — at most one open appeal per claim
// at a time, but the table allows history (a second appeal on a
// re-rejected outcome remains possible without schema changes).
model Appeal {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  claimId             String    @db.Uuid
  // Free-form ground for the appeal — operator-authored. Required
  // at start time so the audit trail captures the rationale.
  reason              String
  // Optional structured supporting-document references (Document.id)
  // collected at submit time. JSONB so we can extend without a
  // schema change.
  supportingDocuments Json      @default("[]")
  // Lifecycle phase: 'initiated' | 'submitted' | 'resolved'.
  status              String    @default("initiated")
  // Resolution captured at /resolve. Free text + structured outcome.
  resolutionKind      String?   // 'approved' | 'partially_approved' | 'rejected'
  resolutionNote      String?
  approvedAmount      Int?
  startedAt           DateTime  @default(now())
  submittedAt         DateTime?
  resolvedAt          DateTime?
  startedByUserId     String?   @db.Uuid

  @@index([tenantId, claimId, startedAt])
  @@map("appeal")
}

// Every external-system call (NHCX, PMJAY, ABDM, OpenAI, SMTP) writes
// a row here, both directions. Outbound rows start at status='pending';
// adapter completion flips to 'sent' / 'succeeded' / 'failed'. The
// rawRequest + rawResponse JSONB columns are the forensic record —
// service code is free to overwrite status + failureClass + retryCount
// + completedAt, but not the payload columns once written (enforced
// at the application layer; the migration's CHECK is a Sprint 3
// hardening item).
model IntegrationMessage {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  // Optional FK to a claim — many calls are claim-scoped, but a few
  // (master-data sync, eligibility-only probes) aren't.
  claimId       String?   @db.Uuid
  direction     String    // 'outbound' | 'inbound'
  integration   String    // 'nhcx' | 'pmjay_tms' | 'abdm' | 'openai' | 'textguru' | 'smtp'
  operation     String
  correlationId String
  // Pairs an outbound row with the matching inbound response so a
  // retry doesn't double-charge / double-act.
  idempotencyKey String?
  status        String    @default("pending")
  failureClass  String?
  retryCount    Int       @default(0)
  rawRequest    Json?
  rawResponse   Json?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  lastAttemptAt DateTime?

  @@index([tenantId, integration, status, createdAt])
  @@index([correlationId])
  @@index([claimId])
  @@map("integration_message")
}

// =====================================================
// Master data (Slice O). Platform-level reference tables
// — no tenantId column. SELECT is open to any
// authenticated context (tenant or platform_admin).
// INSERT/UPDATE/DELETE is platform_admin-only.
//
// Versioning is shallow: effectiveFrom/effectiveTo bracket
// when a row is current. Lookups filter on
// effectiveFrom <= now() AND (effectiveTo IS NULL OR
// now() < effectiveTo). When a row is superseded we set
// effectiveTo on the old row and INSERT a new one — we
// never edit the historical record in place.
// =====================================================

model Payer {
  id            String    @id @default(uuid()) @db.Uuid
  // Stable upper-snake code, e.g. 'MEDIASSIST', 'PARAMOUNT', 'SHA_PMJAY'.
  code          String    @unique
  name          String
  // 'private_tpa' | 'private_insurer' | 'pmjay_sha' | 'cghs' | 'self'
  payerType     String
  rail          String    // 'nhcx' | 'pmjay' | 'self_pay'
  // NHCX participant code if registered on the gateway. Optional —
  // self-pay and unregistered TPAs leave it null.
  hcxCode       String?
  active        Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([rail, active])
  @@index([effectiveFrom, effectiveTo])
  @@map("payer")
}

// PMJAY HBP packages and private-rail treatment package master.
// pmjayHbp=true rows are the national Health Benefits Package list;
// pmjayHbp=false rows are tariff-style entries that hospitals add for
// their own catalogue.
model Package {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  category      String?
  // Base package amount in PAISE (so 35000.00 INR = 3_500_000).
  amount        Int
  pmjayHbp      Boolean   @default(false)
  active        Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category, active])
  @@index([pmjayHbp, active])
  @@map("package")
}

// ICD-10-CM diagnosis codes. Code is the natural primary key —
// e.g. 'I10', 'J18.9', 'K35.80'. We accept both the dotted and
// undotted forms; the canonical storage is the dotted form.
model IcdCode {
  code        String  @id
  description String
  // ICD-10 chapter (I–XXII) — e.g. 'IX' for circulatory.
  chapter     String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@map("icd_code")
}

// Procedure / billing codes. Hospitals price these; payer settlements
// reference the code on each line item. baseAmount is in paise.
model BillingCode {
  code        String  @id
  description String
  category    String?
  baseAmount  Int?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, active])
  @@map("billing_code")
}

// Document checklist rules. The pre-auth, discharge and claim phases
// query this table to compute the required-docs list shown to the
// executive. payerId/packageCode/admissionType narrow the rule
// applicability — NULL means "applies to all".
model DocumentChecklistRule {
  id            String    @id @default(uuid()) @db.Uuid
  // Phase the rule applies to. 'all' is shorthand for any phase.
  phase         String    // 'preauth' | 'discharge' | 'claim' | 'all'
  rail          String    // 'nhcx' | 'pmjay' | 'self_pay'
  documentType  String    // see DocumentType enum
  required      Boolean   @default(true)
  // Optional narrowing scope. payerCode and packageCode reference the
  // master-data tables loosely (not FK'd because rules can be drafted
  // ahead of master data).
  payerCode     String?
  packageCode   String?
  admissionType String?   // 'planned' | 'emergency' | 'day_care'
  // Free-form narrowing predicates — readers should treat unknown keys
  // as "no constraint" so adding a key never breaks old rules.
  conditions    Json      @default("{}")
  active        Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phase, rail, active])
  @@index([payerCode, packageCode])
  @@map("document_checklist_rule")
}

// Append-only via RLS (see migration). Application code that tries to
// UPDATE or DELETE rows is silently rejected.
// Slice BR — DPDP §17 data access ledger. Append-only record of
// every read of personal data (decryption of an encrypted PII
// field, bulk view of a PII-bearing list, audit-log query). Distinct
// from `audit_log` which records state changes; this ledger
// records reads. DPDP Rules 2025 require this for compliance and
// expect operators to be able to answer "show me every time this
// patient's data was accessed".
//
// Append-only at the RLS level (no UPDATE/DELETE policies on the
// access path; the BP retention sweeper is the only DELETE
// pathway, gated by retention class). Class is 'governance' by
// default (8y) since access logs document compliance posture; ops
// can reclassify to 'security' for non-PII access if/when surface
// expands.
model DataAccessEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  occurredAt     DateTime @default(now())
  // Actor — null when system-driven (NHCX inbound dispatcher
  // touching PII for FHIR-bundle parsing, retention sweeper, etc.).
  actorUserId    String?  @db.Uuid
  actorType      String   // 'user' | 'system' | 'scheduled'
  // What was read.
  resourceType   String   // 'patient' | 'case' | 'audit_log' | etc.
  resourceId     String?
  // 'decrypt' | 'list' | 'view' | 'export'
  action         String
  // Why the read happened. Free-text but conventional values:
  // 'eligibility.verify' | 'preauth.submit' | 'manual_view' |
  // 'audit_query' | 'audit_export' | 'erasure_check' | etc.
  purpose        String
  // Optional list of sensitive field names that were touched
  // (e.g. ['aadhaarCipher', 'mobileCipher'] when decrypting). The
  // dashboard surfaces this so operators can see *which* fields
  // were accessed, not just that the row was touched.
  fieldNames     Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  // Slice BT — optional binding to the ConsentRecord that authorised
  // this access. Service callers thread it through ctx; null means
  // the read happened under a non-consent lawful basis (legitimate
  // use, legal obligation) or the call site hasn't been wired to
  // consent yet. The compliance dashboard (BU) can group by
  // consentGrantId to answer "show every read authorised by this
  // grant" and surface reads with no binding for triage.
  consentGrantId String?  @db.Uuid

  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorUserId])
  @@index([tenantId, consentGrantId])
  // CD — BU recent-decrypts list + unbound-count query.
  @@index([tenantId, action, occurredAt])
  @@map("data_access_event")
}

// Slice BQ — DPDP Act 2023 §11 erasure-on-request log. One row per
// data-subject erasure request the platform receives. The body of
// the redaction (patient PII null-ing, case denormalised-name
// scrubbing) happens against the Patient + Case rows themselves;
// this table is the audit/compliance record that lets us prove
// we honoured (or rejected, with reason) every request.
//
// Status is final at insert time — v1 doesn't have a pending /
// verified intermediate state because admins process synchronously.
// Future BT consent UI may add staged states; for now every row is
// either 'completed' or 'rejected'.
model ErasureRequest {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  // Patient whose data was erased. Nullable because we may
  // eventually accept tenant-wide / operator-user requests; v1
  // requires a patientId.
  patientId         String?  @db.Uuid
  // Free-text capture of who filed the request (ops desk reading
  // off a paper form, an in-person ABHA / mobile match, etc.).
  // Not authoritative — verification mechanism is on the audit
  // ledger, not here.
  requestedBy       String
  reason            String?
  // 'completed' = redaction performed; 'rejected' = active claims
  // blocked the erasure (DPDP §13 carve-out for legal compliance).
  status            String
  // When status='rejected', list of blocking claim ids + their
  // statuses so the operator can come back when claims close.
  rejectionReason   Json?
  // When status='completed', per-table affected-row counts
  // (patient, case, etc.).
  affectedCounts    Json?
  processedByUserId String?  @db.Uuid
  createdAt         DateTime @default(now())
  completedAt       DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, patientId])
  @@map("erasure_request")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  occurredAt   DateTime @default(now())
  actorUserId  String?  @db.Uuid
  actorType    String
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  correlationId String?
  // Slice BO — retention classification driving the BP sweeper, BQ
  // erasure-on-request consent check, and BU compliance dashboard.
  // Values are stable semantic labels: financial / clinical /
  // security / session / governance / consent. The actual year
  // mapping lives in `retention-classes.ts` so policy can change
  // without a schema migration.
  retentionClass String @default("financial")

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, occurredAt])
  // BP will use this index for a "rows past retention" sweep.
  @@index([retentionClass, occurredAt])
  // CD — BU's per-tenant per-class past-floor counts (dashboard).
  @@index([tenantId, retentionClass, occurredAt])
  @@map("audit_log")
}

// Slice BS — DPDP §8(6) breach incident record. One row per
// detected (or operator-filed) anomaly that *might* require a
// 72-hour breach notification to the Data Protection Board. The
// detector populates rows automatically from data_access_event
// patterns; operators can also file rows manually for incidents
// the heuristic doesn't catch (lost laptop, vendor breach, etc.).
//
// Lifecycle:
//   detected → notified | dismissed | resolved
//
// dpdpNotificationDueAt is openedAt + 72h. Rows where
// dpdpNotificationSentAt is null and the deadline has passed
// surface red on BU's compliance dashboard. dpdpNotificationPayload
// snapshots the rendered template at notify-time so we can prove
// what was sent.
//
// Detector idempotency: the unique constraint on
// (tenantId, kind, actorUserId, windowStart) prevents the same
// scan-window from creating duplicate incidents on re-runs. Manual
// rows have actorUserId nullable + windowStart nullable to skip
// the constraint (manual reports aren't deduplicated).
model BreachIncident {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @db.Uuid
  // 'BURST_DECRYPT' = single actor decrypted > N patients in M
  // minutes (auto-detected from data_access_event). 'MANUAL_REPORT'
  // = operator filed via POST /breach-incidents.
  kind                     String
  // 'low' | 'medium' | 'high' | 'critical'. Detector emits 'high'
  // for bursts; manual reports take the operator's classification.
  severity                 String
  // 'detected' | 'notified' | 'dismissed' | 'resolved'. State
  // machine lives in the service; UPDATE policy permits same-tenant
  // flips so the controller can mark notified / dismissed.
  status                   String   @default("detected")
  // Suspect actor for auto-detected rows; null for manual reports
  // where the actor isn't the on-platform user (vendor breach,
  // lost device, etc.).
  actorUserId              String?  @db.Uuid
  // Distinct count of data principals (patients) whose data the
  // detector observed being touched. Drives the §8(6) "categories
  // and approximate number of data principals affected" line in
  // the notification template.
  affectedDataPrincipals   Int      @default(0)
  // Field-name + resourceType labels affected. JSON list of strings
  // ['aadhaar', 'mobile', 'patient'] for the template's "categories
  // of personal data affected" line.
  dataCategories           Json
  // Free-text description. Auto-detected rows get a structured
  // synopsis; manual rows take operator copy.
  description              String
  // Up to N data_access_event ids that the detector attributes to
  // this incident. Audit-trail for "what evidence triggered this?"
  // Capped server-side so the JSON stays bounded.
  evidenceEventIds         Json
  // Detector's observation window. windowStart is rounded down to
  // the minute boundary so re-runs of the scan in the same minute
  // converge on the same primary key (idempotency). Null for
  // manual reports.
  windowStart              DateTime?
  windowEnd                DateTime?
  openedAt                 DateTime @default(now())
  // openedAt + 72h. Stamped at INSERT time so the dashboard query
  // is a simple `dpdpNotificationDueAt < now()` comparison.
  dpdpNotificationDueAt    DateTime
  dpdpNotificationSentAt   DateTime?
  // Snapshot of the rendered notification template at notify-time
  // (subject + body + structured fields). Empty until status flips
  // to 'notified'.
  dpdpNotificationPayload  Json?
  dismissalReason          String?
  processedByUserId        String?  @db.Uuid
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([tenantId, kind, actorUserId, windowStart])
  @@index([tenantId, openedAt])
  @@index([tenantId, status])
  @@index([tenantId, kind])
  @@index([tenantId, dpdpNotificationDueAt])
  @@map("breach_incident")
}

// Slice BT — DPDP Act 2023 §6 / Rule 8 consent record. One row per
// (patient, consentType) grant-or-withdrawal lifecycle. Captures the
// lawful basis the operator is relying on plus the evidence of the
// notice that was shown to the data principal.
//
// Lifecycle:
//   granted → withdrawn   (data principal exercises §13 right)
//   granted → expired     (passes expiresAt without renewal)
//   granted → superseded  (a newer grant covers the same scope —
//                          v1 doesn't auto-supersede; reserved)
//
// `requireConsent(patientId, consentType)` reads the latest
// status='granted' row whose expiresAt is null or in the future. If
// none exists the caller throws a domain error and the access
// short-circuits before any decryption.
//
// RLS: same-tenant SELECT + INSERT + UPDATE (status flips for
// withdrawal). DELETE blocked — consent records are themselves a
// compliance artifact and outlast the data they authorised.
model ConsentRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  patientId          String   @db.Uuid
  // Stable label: 'nhcx_processing' | 'pmjay_processing' |
  // 'analytics' | 'communication' | etc. Code paths gate access on
  // a known string; new types land in the contracts package first.
  consentType        String
  // List of personal-data categories the grant covers. Conventional
  // labels: 'aadhaar' | 'mobile' | 'medical_records' | etc. Used by
  // BU's dashboard to filter "what data am I authorised to read".
  dataCategories     Json
  // List of purposes the grant authorises. Same vocabulary as
  // data_access_event.purpose ('eligibility.verify' | 'preauth.submit'
  // | etc.) so the binding round-trips. Empty list = bound to
  // consentType only (legacy callers).
  purposes           Json
  // 'consent' | 'legitimate_use' | 'legal_obligation' |
  // 'public_interest'. Most rows are 'consent' — the others are for
  // emergency / regulatory reads that DPDP §7 carve-outs allow
  // without an explicit grant. Captured here so the access ledger
  // can surface the basis without joining a separate table.
  lawfulBasis        String   @default("consent")
  // 'granted' | 'withdrawn' | 'expired' | 'superseded'. UPDATE
  // policy permits same-tenant flips; the service enforces the
  // legal sequencing.
  status             String   @default("granted")
  // Free-text capture of how the grant was obtained — 'in_person'
  // | 'abha_otp' | 'paper_form_doc:<docId>' | 'tele_consent_call:<id>'.
  // Operators map this to their existing channels.
  source             String
  // Snapshot of the notice the data principal saw at consent time.
  // Stored verbatim so a later DPDP audit can reconstruct what they
  // agreed to even after the platform's notice copy changes.
  evidence           Json
  grantedAt          DateTime @default(now())
  expiresAt          DateTime?
  withdrawnAt        DateTime?
  withdrawalReason   String?
  capturedByUserId   String?  @db.Uuid
  // Optional link to the document_storage row holding a scanned
  // paper form / signed PDF. Decoupled from the evidence JSON so a
  // future S3-backed audit can reach back to the original artifact.
  documentId         String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, patientId, consentType, status])
  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
  // CD — BU recent-consent-changes list orders by updatedAt.
  @@index([tenantId, updatedAt])
  @@map("consent_record")
}
