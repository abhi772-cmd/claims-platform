// Walking-skeleton schema. Tenant + auth surface only.
// Business modules (case, claim, claim_event, integration_message, etc.)
// land in subsequent sprints — see docs/03-data-model.md for the full plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MIGRATOR")
}

enum TenantLifecycleState {
  CONTRACTED
  PROVISIONING
  IN_SETUP
  PILOT
  LIVE
  SUSPENDED
  CHURNED
}

enum UserStatus {
  invited
  active
  suspended
  deactivated
}

model Tenant {
  id              String               @id @default(uuid()) @db.Uuid
  slug            String               @unique
  displayName     String
  lifecycleState  TenantLifecycleState @default(IN_SETUP)
  logoUrl         String?
  // Tenant-level IP allowlist. Stored as a JSON array of CIDR strings
  // ("203.0.113.0/24", "2001:db8::/32") or single IPs. Empty array (the
  // default) means no restriction. platform_admin bypasses regardless.
  ipAllowlist     Json                 @default("[]")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  users User[]
  roles Role[]

  @@map("tenant")
}

// Roles can be tenant-scoped (most cases) or platform-wide (platform_admin
// has tenantId = NULL). The runtime queries with the platform_admin GUC
// when handling pre-tenant flows like login.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  name        String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, name])
  @@map("role")
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String     @db.Uuid
  email                String     @unique
  mobile               String?
  // Empty string for invited-but-not-accepted users; set during accept-invite.
  // argon2 verify() fails on a non-argon2 string, so login refuses these.
  passwordHash         String
  status               UserStatus @default(active)
  firstName            String
  lastName             String
  designation          String?
  mfaEnabled           Boolean    @default(false)
  mfaSecret            String?
  mustChangePassword   Boolean    @default(false)
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  lastLoginUserAgent   String?
  // Invitation flow (Slice B). Token is hashed on storage; raw token only
  // exists in the email/SMS the invitee receives.
  inviteTokenHash      String?    @unique
  inviteTokenExpiresAt DateTime?
  inviteAcceptedAt     DateTime?
  invitedById          String?    @db.Uuid
  // Password lifecycle. lastPasswordChangeAt is null for users who have
  // never accepted (passwordHash = '').
  lastPasswordChangeAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles         UserRole[]
  sessions          Session[]
  inviteResends     InviteResend[]
  passwordHistory   PasswordHistory[]
  passwordResets    PasswordResetToken[]
  mfaEnrollment     MfaEnrollment?
  backupCodes       BackupCode[]
  mfaChallenges     MfaChallenge[]
  trustedDevices    TrustedDevice[]
  doctorTokens      DoctorToken[]        @relation("DoctorTokensByDoctor")
  doctorTokensIssued DoctorToken[]       @relation("DoctorTokensByIssuer")

  @@index([tenantId, status])
  @@index([inviteTokenExpiresAt])
  @@map("user")
}

// Tracks invite resends for rate limiting (3 per 24h per user) and audit.
model InviteResend {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  resentBy  String   @db.Uuid
  resentAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, resentAt])
  @@map("invite_resend")
}

// Persistent outbox for notifications (email + SMS). Workers poll status='queued'
// and dispatch via the Email/Sms adapters. Status transitions on success/failure.
// Kept tenant-scoped so RLS isolation applies.
model NotificationOutbox {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  channel      String   // 'email' | 'sms' | 'in_app'
  templateKey  String
  recipient    String   // email address or phone number
  payload      Json
  status       String   @default("queued") // 'queued' | 'sent' | 'failed'
  attempts     Int      @default(0)
  lastError    String?
  scheduledAt  DateTime @default(now())
  sentAt       DateTime?

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, recipient])
  @@map("notification_outbox")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_role")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  // Last refresh hit — used by the session list page to show "active 5 min
  // ago" and by future analytics. Updated on every refresh + tokens use.
  lastSeenAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("session")
}

// Long-lived "remember this device" credential. Issued on /auth/mfa/verify
// when the user opts in via trustDevice=true; stores only sha256(token)
// at rest. Validity = 30 days. The user can list/revoke these from
// /me/trusted-devices.
model TrustedDevice {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  // Coarse fingerprint to bind the cookie to the device that requested it.
  // We use the User-Agent string sha256 — not bullet-proof, but stops a
  // stolen cookie from working from a wildly different browser.
  uaFingerprint String?
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("trusted_device")
}

// Audit pointer for refresh-token reuse detection. When we rotate a refresh
// token we record the previous hash here. If it ever shows up again, it's
// reuse — we kill all of that user's sessions (D-001 behaviour from
// docs/14 §refresh-token-rotation).
model SessionTokenHistory {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  rotatedAt        DateTime @default(now())

  @@index([userId])
  @@map("session_token_history")
}

// Append-only password history. We block reuse of the last N hashes
// (default 5) — the policy module reads the most recent rows and runs
// argon2.verify against each. Old hashes are retained beyond the depth
// for audit / forensics; only the top-N are checked for reuse.
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  changedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, changedAt])
  @@map("password_history")
}

// One row per reset request. Tokens are hashed on storage, raw token only
// exists in the email. The row is marked usedAt on successful reset; we
// also track requestedIp and a daily rate-limit count via a query on
// occurredAt rather than a separate counter.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  requestedAt DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  requestedUa String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, requestedAt])
  @@index([expiresAt])
  @@map("password_reset_token")
}

// Pending MFA enrollment OR confirmed enrollment. One row per user.
// `confirmedAt` flips from null to a timestamp on /auth/me/mfa/confirm.
// We keep the pending row separate from the confirmed state so that a
// half-finished setup never leaves the user's confirmed login broken.
// The secret is base32 (otpauth standard) and is rotated on every new
// setup attempt.
model MfaEnrollment {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  userId              String    @unique @db.Uuid
  secret              String
  confirmedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Last verified TOTP step — used to prevent code replay within the same
  // 30-second window. Set on each successful verify; if a verify presents
  // a step <= this value, it's a replay and we reject.
  lastUsedStep        BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("mfa_enrollment")
}

// Backup codes are issued in batches of 10 on confirm + on regenerate.
// Stored hashed (sha256). usedAt is append-only via RLS — the row is
// either unused (NULL) or carries the timestamp of the single use that
// burned it.
model BackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("backup_code")
}

// Server-side staging row for the two-step login. When MFA is required,
// /auth/login does the password check, opens a challenge, and returns
// the challengeId to the client. The client then calls /auth/mfa/verify
// with challengeId + TOTP/backup code. The challenge expires in 5 min.
model MfaChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  challengeId String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("mfa_challenge")
}

// Short-lived (10-min) opaque token used to authorise a doctor's clinical
// signature on a pre-auth without forcing them to log in. Sent via the
// doctor's email/SMS by the insurance desk. Hashed (sha256) at rest;
// raw token only exists in the email/SMS link.
//
// usedAt flips on a successful sign call (single-use). signedHprId +
// signedFullName + signedAt + signatureNote capture the proof — pre-auth
// records reference these for evidentiary purposes once Sprint 2's
// claim_id linkage lands.
model DoctorToken {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  doctorUserId  String    @db.Uuid
  createdById   String    @db.Uuid
  scope         String    // 'preauth_clinical_sign' (one of DoctorTokenScope)
  caseRef       String
  patientName   String
  tokenHash     String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  usedAt        DateTime?
  signedHprId   String?
  signedFullName String?
  signatureNote String?
  ipAddress     String?
  userAgent     String?

  doctor    User @relation("DoctorTokensByDoctor", fields: [doctorUserId], references: [id], onDelete: Cascade)
  createdBy User @relation("DoctorTokensByIssuer", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, doctorUserId])
  @@index([expiresAt])
  @@map("doctor_token")
}

// Append-only via RLS (see migration). Application code that tries to
// UPDATE or DELETE rows is silently rejected.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  occurredAt   DateTime @default(now())
  actorUserId  String?  @db.Uuid
  actorType    String
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  correlationId String?

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, occurredAt])
  @@map("audit_log")
}
