{
  "name": "@claims/api",
  "version": "0.0.0",
  "private": true,
  "description": "Claims platform NestJS API",
  "scripts": {
    "dev": "ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "dev:worker": "cross-env MODE=worker ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config test/jest-e2e.json --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:seed": "ts-node --transpile-only --project tsconfig.json prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@claims/contracts": "workspace:*",
    "@claims/error-codes": "workspace:*",
    "@nestjs/common": "10.3.9",
    "@nestjs/config": "3.2.2",
    "@nestjs/core": "10.3.9",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.3.9",
    "@prisma/client": "5.15.0",
    "argon2": "0.40.3",
    "cookie-parser": "1.4.6",
    "nestjs-pino": "4.1.0",
    "nodemailer": "6.9.14",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino": "9.2.0",
    "pino-http": "10.1.0",
    "pino-pretty": "11.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@claims/eslint-config": "workspace:*",
    "@nestjs/cli": "10.3.2",
    "@nestjs/schematics": "10.1.1",
    "@nestjs/testing": "10.3.9",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.12.7",
    "@types/nodemailer": "6.4.15",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "5.15.0",
    "supertest": "7.0.0",
    "testcontainers": "10.10.4",
    "ts-jest": "29.1.5",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.16.2",
    "typescript": "5.4.5"
  }
}
