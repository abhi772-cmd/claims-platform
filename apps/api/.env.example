NODE_ENV=development
MODE=api
PORT=3001

# Two URLs: app role for runtime queries, migrator role for schema changes.
DATABASE_URL=postgresql://claims_app:claims_app_dev@localhost:5433/claims_dev?schema=public
DATABASE_URL_MIGRATOR=postgresql://claims_migrator:claims_migrator_dev@localhost:5433/claims_dev?schema=public

# JWT (RS256). Use base64 of the PEM content. Generate with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w0 < private.pem
#   base64 -w0 < public.pem
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=claims-platform
JWT_AUDIENCE=claims-platform-web

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=info

# OVH KMS — placeholder, real values fetched from secrets manager in prod
OVH_KMS_ENDPOINT=
OVH_KMS_REGION=
OVH_KMS_KEY_ID=
OVH_KMS_ACCESS_KEY=
OVH_KMS_SECRET_KEY=

# OVH Object Storage
OVH_S3_ENDPOINT=
OVH_S3_REGION=
OVH_S3_BUCKET=
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=

# Redis (skeleton-unused; reserved for sessions/rate-limit in future sprint)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Web app — used to build links inside email/SMS
WEB_BASE_URL=http://localhost:3000

# SMTP (Mailhog locally; relay creds per-tenant in prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@digisparsh.in

# Invitation flow
INVITE_TOKEN_TTL_HOURS=168
INVITE_RESEND_LIMIT_PER_DAY=3

# Password reset (Slice C)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_PER_DAY=5

# Sessions / trusted devices / concurrent cap (Slice E)
CONCURRENT_SESSION_LIMIT=5
TRUSTED_DEVICE_TTL_DAYS=30

# Doctor short-token + HPR stub (Slice F)
# HPR_STUB_ALLOWLIST is a comma-separated list of HPR ids the stub
# treats as valid. Real ABDM HPR integration replaces this in Sprint 2.
DOCTOR_TOKEN_TTL_MINUTES=10
HPR_STUB_ALLOWLIST=
HPR_STUB_OTP=000000

# NHCX stub adapter (Slice K). Replaced by the real adapter in Slice P.
# NHCX_STUB_VERIFY_DEFAULT controls the outcome when no override fires;
# NHCX_STUB_MRN_FAIL_LIST is a comma-separated list of hospital MRNs
# that always fail.
NHCX_STUB_VERIFY_DEFAULT=true
NHCX_STUB_MRN_FAIL_LIST=
